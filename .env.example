# Copy to .env and fill in. Never commit your real .env.

# --- Database ---
DATABASE_URL=postgresql+psycopg2://ctbacktest:ctbacktest@localhost:5432/ctbacktest

# --- Ingestion compliance ---
# The Senate eFD system's terms of use restrict use of Financial Disclosure
# Report data (see FEASIBILITY.md #9). Set to "true" only after you have
# personally read https://efdsearch.senate.gov/search/ 's terms and intend to
# use this only for personal, non-commercial research, per this project's scope.
CTBACKTEST_ACCEPT_SENATE_EFD_TERMS=false

# --- Optional paid market data (for validating recent trades at intraday resolution) ---
POLYGON_API_KEY=

# --- Dashboard ---
CTBACKTEST_DASHBOARD_HOST=127.0.0.1
CTBACKTEST_DASHBOARD_PORT=8000
